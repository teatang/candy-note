{
  "name": "candy-note",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "糖果笔记 (Candy Note) - 基于 Cloudflare Workers + D1 + R2 的多用户云笔记网站",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "wrangler dev --assets dist",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply candy-note-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply candy-note-db --remote",
    "deploy2cf": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dompurify": "^3.2.4",
    "element-plus": "^2.9.5",
    "hono": "^4.7.4",
    "marked": "^15.0.7",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^17.4.4",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.9",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
